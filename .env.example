# =============================================================================
# GEODATA MART ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for development.
# Copy this file to .env and customize as needed.
#
# ⚠️  SECURITY WARNING: Never commit .env to version control!
# ⚠️  For production, generate strong random values for all secrets!
# =============================================================================

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

# Docker Compose project name (affects container names)
COMPOSE_PROJECT_NAME=datamart

# =============================================================================
# DJANGO SUPERUSER (Initial Admin Account)
# =============================================================================
# These credentials are used to create the initial superuser
# ⚠️  Change these in production!

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@dev.localhost

# =============================================================================
# SERVICE PORTS
# =============================================================================
# Customize these if you have port conflicts

POSTGRES_PORT=5432
POSTGRES_SERVICE_PORT=5432
DJANGO_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DJANGO_AWS_S3_CUSTOM_DOMAIN=http://minio:9000
MAILHOG_PORT=9002
FLOWER_PORT=9003
DOCS_PORT=9004
QGIS_WPS_PORT=9005

# =============================================================================
# DJANGO DEVELOPMENT SETTINGS
# =============================================================================

# Use Docker for development
USE_DOCKER=yes

# IPython directory for Django shell
IPYTHONDIR=/app/.ipython

# Django settings module (dev/production/frontend/test)
DJANGO_SETTINGS_MODULE=config.settings.dev

# =============================================================================
# DJANGO GENERAL SETTINGS
# =============================================================================

# Read .env file in Django settings
DJANGO_READ_DOT_ENV_FILE=True

# Django settings module for production (uncomment for production)
#DJANGO_SETTINGS_MODULE=config.settings.production

# Django secret key - MUST be kept secret in production!
# Generate a new one: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=R9p64ruAlEODA71V4DGzSpoKuLrqNHAsyFgShLG7xIwIpzrAsCPj76QYLmdvSCzi

# Django admin URL path (customize for security)
# Access admin at http://localhost:8000/<DJANGO_ADMIN_URL>/
DJANGO_ADMIN_URL=QJk9OHohPnIyM9JOkyfjE9mpMHd7VrWB/

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=example.com

# SSL redirect (set to True in production with HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False

# Server email for error notifications
DJANGO_SERVER_EMAIL=noreply@example.com

# Allow user registration
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================

# PostgreSQL version configuration
POSTGRES_MAJOR_VERSION=15
POSTGIS_MAJOR_VERSION=3
POSTGIS_MINOR_RELEASE=3

# Database credentials
# ⚠️  Use strong, random passwords in production!
POSTGRES_DB=geodatamart
POSTGRES_USER=zo16dNjHFut9pTAxzDYNGM9WZr8oSEyp
POSTGRES_PASS=RAyM15cIJGTfE2MIYOxEKlNafouGTIfTybBucTmGxXv3l7cJHCd0Kry7w2lyo4L4

# PostgreSQL network configuration
ALLOW_IP_RANGE=0.0.0.0/0
POSTGRES_HOST=postgres

# PostgreSQL extensions (comma-separated)
POSTGRES_MULTIPLE_EXTENSIONS=postgis,hstore,postgis_topology,postgis_raster,pgrouting

# SSL configuration
FORCE_SSL=TRUE
SSL_MODE=require

# =============================================================================
# MINIO (S3-Compatible Object Storage)
# =============================================================================
# MinIO is used for file storage in development
# Access console at http://localhost:9001

# MinIO credentials
# ⚠️  Change these in production!
DJANGO_AWS_ACCESS_KEY_ID=6JUqLLDNF2k2rLNo6
DJANGO_AWS_SECRET_ACCESS_KEY=aNJphrpq379R4gzsWdFU2n7C89WDQcNueLR8SxGrP4KdWbwM4PfGH6nf4WyH

# Storage bucket name
DJANGO_AWS_STORAGE_BUCKET_NAME=geodatamart

# =============================================================================
# GUNICORN (Production Web Server)
# =============================================================================

# Number of Gunicorn worker processes
WEB_CONCURRENCY=4

# =============================================================================
# EMAIL CONFIGURATION (Production)
# =============================================================================
# For development, emails are caught by MailHog (http://localhost:9002)
# For production, configure these with real credentials

MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# =============================================================================
# REDIS (Cache and Message Broker)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================

# Celery broker URL (uses Redis)
CELERY_BROKER_URL="${REDIS_URL}"

# Flower monitoring credentials
# Access Flower at http://localhost:9003
CELERY_FLOWER_USER=YVenVhJQPeKOcyrFLxJKpPsPErwjTFtG
CELERY_FLOWER_PASSWORD=LW75Zsa4i4HbHFS4xooQJlFjG08GdKiK08nLHRni726TRAGkie5GpUXszpBaxujl

# =============================================================================
# MONITORING (Production)
# =============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# =============================================================================
# QGIS SERVER
# =============================================================================

# QGIS authentication database seed password
QGISAUTHDBSEEDPW=

# Qt platform (required for headless operation)
QT_QPA_PLATFORM=offscreen

# =============================================================================
# APPLICATION FEATURES
# =============================================================================

# Load sample projects on first run
SAMPLE_PROJECTS=True

# =============================================================================
# WINDOWS-SPECIFIC SETTINGS
# =============================================================================
# Uncomment this if running on Windows to prevent Celery worker failures
# FORKED_BY_MULTIPROCESSING=1
